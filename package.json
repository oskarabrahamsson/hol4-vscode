{
    "name": "hol4-mode",
    "displayName": "HOL4 mode",
    "description": "A VSCode extension for interacting with the HOL4 theorem prover",
    "version": "0.0.20",
    "repository": "https://github.com/oskarabrahamsson/hol4-vscode",
    "engines": {
        "vscode": "^1.75.0"
    },
    "publisher": "oskarabrahamsson",
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:hol4"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "grammars": [
            {
                "language": "hol4",
                "scopeName": "source.hol4",
                "path": "./hol4-grammar.json"
            }
        ],
        "languages": [
            {
                "id": "hol4",
                "extensions": [
                    ".sig",
                    ".sml"
                ],
                "aliases": [
                    "HOL4"
                ],
                "configuration": "./hol4-language.json",
                "filenamePatterns": [
                    "*Script.sml"
                ]
            }
        ],
        "commands": [
            {
                "command": "hol4-mode.startSession",
                "title": "Start session",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.stopSession",
                "title": "Stop session",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.interrupt",
                "title": "Interrupt HOL process",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.input.convert",
                "title": "Input: Convert Current Abbreviation",
                "description": "Converts the current abbreviation (e.g. \\lam).",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendSelection",
                "title": "Send selection",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendUntilCursor",
                "title": "Send all up to current line",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendGoal",
                "title": "Send goal",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendSubgoal",
                "title": "Send subgoal",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendTactic",
                "title": "Send tactic",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.sendTacticLine",
                "title": "Send tactic line",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.proofmanShow",
                "title": "Show current goal",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.proofmanRotate",
                "title": "Rotate between subgoals",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.proofmanRestart",
                "title": "Restart current goal",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.proofmanDrop",
                "title": "Drop current goal",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.proofmanBack",
                "title": "Step backwards in current goal",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.holmake",
                "title": "Run Holmake in the directory of the current document",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.toggleShowAssums",
                "title": "Toggle printing of theorem hypotheses",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.toggleShowTypes",
                "title": "Toggle printing of term types",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.clearAll",
                "title": "Clear history",
                "icon": "$(close)",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.restart",
                "title": "Restart session",
                "icon": {
                    "light": "resources/light/interrupt.svg",
                    "dark": "resources/dark/interrupt.svg"
                },
                "category": "HOL"
            },
            {
                "command": "hol4-mode.expandAllCells",
                "title": "Expand all cells",
                "icon": "$(expand-all)",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.collapseAllCells",
                "title": "Collapse all cells",
                "icon": "$(collapse-all)",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.toggleGoalsPane",
                "title": "Toggle HOL Goals pane",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.restart",
                "title": "Restart LSP server for the active script",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.showOutput",
                "title": "Show LSP output channel for the active script",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.retryCompile",
                "title": "Compile the active script again",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.gotoOutstandingProof",
                "title": "Go to the next unchecked proof",
                "category": "HOL"
            },
            {
                "command": "hol4-mode.lsp.search",
                "title": "Search for theorems"
            }
        ],
        "keybindings": [
            {
                "command": "hol4-mode.input.convert",
                "key": "tab",
                "mac": "tab",
                "when": "editorTextFocus && hol4-mode.input.isActive"
            },
            {
                "command": "hol4-mode.startSession",
                "key": "ctrl+h h",
                "mac": "cmd+h h",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.stopSession",
                "key": "ctrl+h ctrl+x",
                "mac": "cmd+h cmd+x",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.interrupt",
                "key": "ctrl+h ctrl+c",
                "mac": "cmd+h cmd+c",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.sendSelection",
                "key": "ctrl+h s",
                "mac": "cmd+h s",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.sendUntilCursor",
                "key": "ctrl+h ctrl+shift+s",
                "mac": "cmd+h cmd+shift+s",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.sendGoal",
                "key": "ctrl+h g",
                "mac": "cmd+h g",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.sendSubgoal",
                "key": "ctrl+h ctrl+s",
                "mac": "cmd+h ctrl+s",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.sendTactic",
                "key": "ctrl+h e",
                "mac": "cmd+h e",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.sendTacticLine",
                "key": "ctrl+h ctrl+e",
                "mac": "cmd+h ctrl+e",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.proofmanShow",
                "key": "ctrl+h p",
                "mac": "cmd+h p",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.proofmanBack",
                "key": "ctrl+h b",
                "mac": "cmd+h b",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.proofmanRestart",
                "key": "ctrl+h shift+r",
                "mac": "cmd+h shift+r",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.proofmanRotate",
                "key": "ctrl+h r",
                "mac": "cmd+h r",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.proofmanDrop",
                "key": "ctrl+h d",
                "mac": "cmd+h d",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.toggleShowTypes",
                "key": "ctrl+h ctrl+t",
                "mac": "cmd+h cmd+t",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.toggleShowAssums",
                "key": "ctrl+h ctrl+a",
                "mac": "cmd+h cmd+a",
                "when": "editorLangId == hol4"
            },
            {
                "command": "hol4-mode.lsp.toggleGoalsPane",
                "key": "ctrl+h ctrl+g",
                "mac": "cmd+h cmd+g",
                "when": "editorLangId == hol4"
            }
        ],
        "menus": {
            "interactive/toolbar": [
                {
                    "command": "hol4-mode.clearAll",
                    "group": "navigation@0",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                },
                {
                    "command": "hol4-mode.restart",
                    "group": "navigation@1",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                },
                {
                    "command": "hol4-mode.expandAllCells",
                    "group": "navigation@2",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                },
                {
                    "command": "hol4-mode.collapseAllCells",
                    "group": "navigation@3",
                    "when": "notebookKernel == 'oskarabrahamsson.hol4-mode/hol4'"
                }
            ]
        },
        "configuration": {
            "title": "HOL4",
            "properties": {
                "hol4-mode.rawMessages": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show raw input/output in console view"
                },
                "hol4-mode.holdir": {
                    "type": "string",
                    "description": "Set HOL installation directory"
                },
                "hol4-mode.lsp.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable the HOL4 LSP client. One `bin/hol lsp` process is started per visible `*Script.sml` file, and stopped when the file is closed. Diagnostics, hover, and the HOL Goals pane require this."
                },
                "hol4-mode.lsp.checkProofs": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check the proofs in a script, rather than taking them on trust. Elaboration does not run tactics, which is what makes it fast; with this on, a worker pool replays each proof and reports one that fails as an error on the theorem's name, and one that suspends or diverges as a warning. It costs what the proofs cost: one worker per processor, capped at eight. Changing it takes effect without a restart."
                },
                "hol4-mode.lsp.openGoalsOnStartup": {
                    "type": "boolean",
                    "default": true,
                    "description": "Open the HOL Goals pane as soon as a HOL script is opened, rather than waiting for `HOL: Toggle the goals pane`. The pane opens beside the editor without taking focus."
                },
                "hol4-mode.lsp.hoverWidth": {
                    "type": "number",
                    "default": 50,
                    "minimum": 20,
                    "maximum": 500,
                    "description": "Column width the language server renders hover text at, including theorem statements. VS Code does not expose the width of a hover box, so this is an estimate rather than a measurement; 50 is about what a default hover box holds. Too narrow only costs extra line breaks, while too wide makes the box scroll sideways, so err low. Raise it if you have a small font or a wide box."
                },
                "hol4-mode.lsp.executable": {
                    "type": "string",
                    "default": "",
                    "description": "Optional path to `bin/hol` for the LSP servers. Empty falls back to `hol4-mode.holdir/bin/hol`, then `$HOLDIR/bin/hol`."
                }
            }
        },
        "configurationDefaults": {
            "[hol4]": {
                "editor.unicodeHighlight.ambiguousCharacters": false,
                "editor.tabSize": 2,
                "editor.insertSpaces": true,
                "files.encoding": "utf8"
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "test:offline": "npm run compile && node test/offline/proof-tally.js && node test/offline/goal-segments.js"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/mocha": "^9.0.0",
        "@types/node": "^20.0",
        "@types/vscode": "^1.63.0",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "@vscode/test-electron": "^2.0.3",
        "eslint": "^9.32.0",
        "glob": "^11.0.0",
        "mocha": "^9.1.3",
        "typescript": "^4.5.4"
    }
}
